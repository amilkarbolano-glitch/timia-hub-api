# ============================================================================
#  Timia Hub API — configuración.  Copia este archivo a .env y completa.
#  Las variables marcadas [GOOGLE] las diligencia quien administra Google Cloud.
# ============================================================================

# --- Base de datos -----------------------------------------------------------
# Con docker compose déjalo así. Atlas: mongodb+srv://usuario:clave@cluster.xxx.mongodb.net
# DocumentDB: mongodb://usuario:clave@host:27017/?tls=true&tlsCAFile=global-bundle.pem&retryWrites=false
MONGO_URL=mongodb://mongo:27017
MONGO_DB=timia
API_PORT=8000

# --- Sesiones ---------------------------------------------------------------
# Obligatorio en producción. Genera uno: openssl rand -base64 48
SESSION_SECRET=
SESSION_HOURS=8
# true cuando la app se sirve por HTTPS
COOKIE_SECURE=false

# --- Google Sign-In [GOOGLE] -------------------------------------------------
# Google Cloud Console → APIs y servicios → Credenciales → Crear → ID de cliente OAuth
#   Tipo: Aplicación web
#   Orígenes JavaScript autorizados: http://localhost  y  https://<dominio-de-la-app>
#   (no requiere URI de redirección; no se necesita el client secret)
GOOGLE_CLIENT_ID=
# Dominios de correo aceptados (coma-separado). Vacío = cualquier correo registrado en el panel
ALLOWED_EMAIL_DOMAINS=timia.ai
# Login de prueba sin contraseña con las cuentas del panel.
# Vacío = activo solo mientras NO haya GOOGLE_CLIENT_ID. Pon "false" para apagarlo siempre.
ALLOW_DEMO_LOGIN=

# --- Integraciones / red -----------------------------------------------------
# API key para scripts o integraciones (header X-API-Key). Opcional
TIMIA_API_KEY=
# Orígenes del front SOLO si no comparte dominio con la API (ej. https://app.timia.ai). Vacío = mismo origen
CORS_ORIGINS=
# Carga seed.json en colecciones vacías al arrancar
SEED_ON_START=true
# Peticiones/minuto por IP en /api/auth/*
AUTH_RATE_LIMIT=30
